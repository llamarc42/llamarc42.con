{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llamarc42 portable tool manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "displayName",
    "description",
    "inputSchema",
    "outputSchema",
    "handler",
    "effects",
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "maxLength": 64
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "inputSchema": {
      "$ref": "#/$defs/object"
    },
    "outputSchema": {
      "$ref": "#/$defs/object"
    },
    "handler": {
      "type": "object",
      "required": ["adapter", "id"],
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "const": "builtin"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.]*$",
          "maxLength": 128
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "workspace.read",
          "workspace.write",
          "process.execute",
          "network.access"
        ]
      }
    },
    "limits": {
      "type": "object",
      "required": ["timeoutMs", "maxOutputBytes"],
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "required": ["type", "properties", "additionalProperties"],
      "properties": {
        "type": {
          "const": "object"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "properties": {
          "type": "object",
          "maxProperties": 128,
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "value": {
      "anyOf": [
        {
          "$ref": "#/$defs/object"
        },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": {
              "const": "array"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "items": {
              "$ref": "#/$defs/value"
            },
            "minItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "maxItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "string"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "maxLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "integer"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "integer"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "number"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "boolean"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
